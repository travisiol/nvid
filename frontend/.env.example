# ─── Site ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://nvid.example
# Where "Buy NVID" sends people (DEX swap link). Falls back to the How-it-works section.
NEXT_PUBLIC_BUY_URL=
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=

# ─── Chain ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_EXPLORER_URL=
# "true" adds the local Hardhat chain (31337) to the wallet chain list for development
NEXT_PUBLIC_ENABLE_LOCAL_CHAIN=false

# ─── Wallets ─────────────────────────────────────────────────────────────────
# https://cloud.reown.com — without it only injected (browser) wallets are offered.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# ─── Contracts ───────────────────────────────────────────────────────────────
# Optional overrides. When empty the app reads lib/abi/deployments.ts, which
# `contracts/scripts/deploy.ts` writes for the current chain id.
NEXT_PUBLIC_NVID_TOKEN_ADDRESS=
NEXT_PUBLIC_REWARD_VAULT_ADDRESS=
NEXT_PUBLIC_FEE_COLLECTOR_ADDRESS=
NEXT_PUBLIC_TREASURY_ADDRESS=
NEXT_PUBLIC_NVDA_TOKEN_ADDRESS=

# ─── Live stats ──────────────────────────────────────────────────────────────
# mock    → deterministic preview numbers (default)
# onchain → RewardVault / Treasury reads over NEXT_PUBLIC_RPC_URL
NEXT_PUBLIC_STATS_SOURCE=mock
# Used by the onchain provider to price the treasury's NVID balance in USD
NEXT_PUBLIC_NVID_PRICE_USD=
# Optional indexer endpoint returning {"count": <holders>} for the Total Holders card
NEXT_PUBLIC_HOLDERS_ENDPOINT=
