# ─── Deployer ────────────────────────────────────────────────────────────────
# Private key of the account that deploys and owns the contracts. Never commit it.
DEPLOYER_PRIVATE_KEY=

# ─── Robinhood Chain ─────────────────────────────────────────────────────────
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ROBINHOOD_CHAIN_ID=4663
# Explorer (used by `hardhat verify`). Leave empty until you have them.
ROBINHOOD_EXPLORER_API_URL=
ROBINHOOD_EXPLORER_URL=
ROBINHOOD_EXPLORER_API_KEY=

# ─── Deployment parameters ───────────────────────────────────────────────────
# Address of the NVDA Stock Token on Robinhood Chain. REQUIRED for a real deploy.
# When empty on the `hardhat` network, the deploy script deploys a MockERC20 instead.
NVDA_TOKEN_ADDRESS=

# Uniswap V3-compatible SwapRouter on Robinhood Chain (exactInput with deadline).
# Can be left empty and set later with FeeCollector.setSwapRouter().
SWAP_ROUTER_ADDRESS=

# Encoded Uniswap V3 path NVID -> ... -> NVDA (hex: token(20) | fee(3) | token(20) ...).
# Can be left empty and set later with FeeCollector.setSwapPath().
SWAP_PATH=

# Wallet / LP manager that receives the 0.5% liquidity share (defaults to deployer).
LIQUIDITY_RECEIVER=

# Final owner of all four contracts (defaults to deployer). Use a multisig in production.
OWNER_ADDRESS=

# ─── Tooling ─────────────────────────────────────────────────────────────────
REPORT_GAS=false
# Set to "true" to stop `hardhat compile` from writing ABIs into ../frontend/lib/abi
SKIP_ABI_EXPORT=false
# Optional: force an EVM target (e.g. paris) if the chain has no PUSH0/MCOPY yet
SOLIDITY_EVM_VERSION=
